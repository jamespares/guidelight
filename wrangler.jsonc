{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guidelight",
  "compatibility_date": "2026-07-03",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "routes": [
    { "pattern": "getguidelight.com", "custom_domain": true },
    { "pattern": "www.getguidelight.com", "custom_domain": true }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guidelight",
      "database_id": "42d1b3f3-9add-4b0d-ac44-2aa2df1ba5c8",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
