{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guidelight",
  "compatibility_date": "2026-07-03",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "routes": [
    { "pattern": "getguidelight.com", "custom_domain": true },
    { "pattern": "www.getguidelight.com", "custom_domain": true }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guidelight",
      "database_id": "42d1b3f3-9add-4b0d-ac44-2aa2df1ba5c8",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "guidelight-audio"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "APP_URL": "https://getguidelight.com",
    "AUTH_FROM_EMAIL": "auth@getguidelight.com",
    "AI_PRICE_INPUT_PER_M": "0.95",
    "AI_PRICE_OUTPUT_PER_M": "4.00",
    "AI_MARKUP_BPS": "20000",
    "DEFAULT_MONTHLY_CAP_CENTS": "2000",
    "DEFAULT_STARTER_CREDIT_CENTS": "500",
    // STRIPE_PUBLISHABLE_KEY must be set via `wrangler secret put STRIPE_PUBLISHABLE_KEY`
    // or env-specific vars. Do not commit Stripe keys to version control.
    "STRIPE_CUSTOMER_PORTAL_LOGIN_URL": "https://billing.stripe.com/p/login/cNiaEW55ZfgP8B47Jw7ok00"
  },
  "triggers": {
    "crons": ["0 6 1 * *"]
  }
}
